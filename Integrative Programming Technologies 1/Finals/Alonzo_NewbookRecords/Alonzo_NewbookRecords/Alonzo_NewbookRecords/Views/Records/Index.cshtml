@model IEnumerable<Alonzo_NewbookRecords.Models.Records>

@{
    ViewData["Title"] = "Current Registered Users";
}

<div style="padding: 2rem; max-width: 1200px; margin: 0 auto;">

    <div style="margin-bottom: 0.5rem; text-align: right; margin-top: 0.5rem;">
        <a asp-controller="Admin" asp-action="Index" style="background-color: #FF0000; color: white; padding: 0.7rem 1.5rem; font-size: 1rem; text-decoration: none; border-radius: 4px;">
            Log Out
        </a>
    </div>
    <div style="margin-bottom: 2rem;">
        <h1 style="font-size: 1rem; color: #2c3e50;">Glad to see you, Admin</h1>
        <h2 style="font-size: 1.8rem; font-weight: bold; color: #0D335D; margin-top: 0.5rem;">Student Records:</h2>
    </div>

    <div>
        <table style="width: 100%; border: none; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #0D335D; color: white; text-align: left;">
                    <th style="padding: 0.8rem;">First Name</th>
                    <th style="padding: 0.8rem;">Last Name</th>
                    <th style="padding: 0.8rem;">Email</th>
                    <th style="padding: 0.8rem;">Phone Number</th>
                    <th style="padding: 0.8rem;">College</th>
                    <th style="padding: 0.8rem;">Prelim Pending?</th>
                    <th style="padding: 0.8rem;">Midterm Pending?</th>
                    <th style="padding: 0.8rem;">Final Pending?</th>
                    <th style="padding: 0.8rem;">Is Scholar?</th>
                    <th style="padding: 0.8rem;">Pending Fee</th>
                    <th style="padding: 0.8rem;">Total Fee</th>
                    <th style="padding: 0.8rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="background-color: #d6eaf8; color: #2c3e50;">
                        <td style="padding: 0.8rem;">@Html.DisplayFor(modelItem => item.FirstName)</td>
                        <td style="padding: 0.8rem;">@Html.DisplayFor(modelItem => item.LastName)</td>
                        <td style="padding: 0.8rem;">@Html.DisplayFor(modelItem => item.Email)</td>
                        <td style="padding: 0.8rem;">@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                        <td style="padding: 0.8rem;">@Html.DisplayFor(modelItem => item.College)</td>
                        <td style="padding: 0.8rem; text-align: center;">@Html.DisplayFor(modelItem => item.PrelimCheck)</td>
                        <td style="padding: 0.8rem; text-align: center;">@Html.DisplayFor(modelItem => item.MidtermCheck)</td>
                        <td style="padding: 0.8rem; text-align: center;">@Html.DisplayFor(modelItem => item.FinalCheck)</td>
                        <td style="padding: 0.8rem; text-align: center;">@Html.DisplayFor(modelItem => item.ScholarCheck)</td>
                        <td style="padding: 0.8rem; text-align: right;">@Html.DisplayFor(modelItem => item.PendingFee)</td>
                        <td style="padding: 0.8rem; text-align: right;">@Html.DisplayFor(modelItem => item.TotalFee)</td>
                        <td style="padding: 0.8rem;">
                            <a asp-action="Edit" asp-route-id="@item.Id" style="color: #007bff; text-decoration: none; margin-right: 0.5rem;">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" style="color: #007bff; text-decoration: none; margin-right: 0.5rem;">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" style="color: #ff0000; text-decoration: none;">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <div style="margin-bottom: 3rem; text-align: right; margin-top: 2rem;">
        <a asp-action="Create" style="background-color: #0D335D; color: white; padding: 0.7rem 1.5rem; font-size: 1rem; text-decoration: none; border-radius: 4px;">
            + Add New
        </a>
    </div>

</div>

