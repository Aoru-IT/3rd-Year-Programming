<!DOCTYPE html>
<html>
<head>
<title>Tabular Data Example</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
<style>
    html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: Poppins;
}

    body {
    position: relative;
    margin: 0;
    padding: 0;
    font-family: Poppins;
    height: 100%;

}

    table {
        background-color: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
        width: 800px;
        text-align: center;
        border: none;
    }

    th {
        background-color: #764b33;
        color: white;
        padding: 10px;
        border: none;
        border-radius: 15px;
    }

    td {
        padding: 10px;
        border: none;
        border-radius: 15px;
    }
    tr:hover {
        background-color: rgba(118, 75, 51, 0.2);
        transition: background-color 0.3s ease;
    }

    .bookstore{
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 70vh;
    }
    h1{
        margin: none;
        color: #852c00;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
    /* FONTS */
    .poppins-thin {
    font-family: "Poppins", sans-serif;
    font-weight: 100;
    font-style: normal;
    }

    .poppins-extralight {
    font-family: "Poppins", sans-serif;
    font-weight: 200;
    font-style: normal;
    }

    .poppins-light {
    font-family: "Poppins", sans-serif;
    font-weight: 300;
    font-style: normal;
    }

    .poppins-regular {
    font-family: "Poppins", sans-serif;
    font-weight: 400;
    font-style: normal;
    }

    .poppins-medium {
    font-family: "Poppins", sans-serif;
    font-weight: 500;
    font-style: normal;
    }

    .poppins-semibold {
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-style: normal;
    }

    .poppins-bold {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-style: normal;
    }

    .poppins-extrabold {
    font-family: "Poppins", sans-serif;
    font-weight: 800;
    font-style: normal;
    }

    .poppins-black {
    font-family: "Poppins", sans-serif;
    font-weight: 900;
    font-style: normal;
    }

    .poppins-thin-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 100;
    font-style: italic;
    }

    .poppins-extralight-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 200;
    font-style: italic;
    }

    .poppins-light-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 300;
    font-style: italic;
    }

    .poppins-regular-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 400;
    font-style: italic;
    }

    .poppins-medium-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 500;
    font-style: italic;
    }

    .poppins-semibold-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-style: italic;
    }

    .poppins-bold-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-style: italic;
    }

    .poppins-extrabold-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 800;
    font-style: italic;
    }

    .poppins-black-italic {
    font-family: "Poppins", sans-serif;
    font-weight: 900;
    font-style: italic;
    }

</style>
</head>
<body>
<h1>Student Database</h1>

<!-- 🔗 Link to go back to the registration form -->
<a href="/register">Go to reg form</a>

<!-- 📋 Table structure -->
<table border="1" align="center">
  <thead>
    <tr>
      <th>Profile Picture</th>
      <th>Student Number</th>
      <th>Name</th>
      <th>Email</th>
    </tr>
  </thead>
  <tbody>

    <!-- 🌀 Loop through each student in the 'students' array -->
    <% students.forEach((student) => { %>
      <tr>
        <!-- 🖼️ Show student's picture from the /uploads folder -->
        <td><img src="/uploads/<%= student.picture %>" width="100" height="100"></td>

        <!-- 🔢 Show student number -->
        <td><%= student.student_number %></td>

        <!-- 🧑 Show student name -->
        <td><%= student.name %></td>

        <!-- 📧 Show student email -->
        <td><%= student.email %></td>
      </tr>
    <% }); %>

  </tbody>
</table>

</body>
</html>
