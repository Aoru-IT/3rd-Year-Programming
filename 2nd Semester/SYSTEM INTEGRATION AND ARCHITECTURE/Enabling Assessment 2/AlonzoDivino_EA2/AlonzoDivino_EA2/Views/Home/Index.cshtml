@{
    ViewData["Title"] = "Home Page";
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f5f5f5;
        color: #333;
        position: relative;
        background: url('/css/dbtk.jpg') no-repeat center center/cover;
    }

        body::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.3;
            z-index: -1;
        }

    .container {
        max-width: 800px;
        margin: 45px auto;
        padding: 20px;
        background: white;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        text-align: center;
    }

    h1, h4 {
        font-size: 28px;
        margin-bottom: 10px;
    }

    p {
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .custom-btn {
        display: block;
        width: 100%;
        padding: 7px 0;
        color: black;
        background-color: white;
        text-decoration: none;
        border-radius: 5px;
        transition: 0.3s;
        border: 1px solid black;
        cursor: pointer;
        font-size: 18px;
        font-weight: bold;
        margin: 7px 0;
    }

        .custom-btn:hover {
            color: white;
            background-color: black;
        }

    a {
        color: #3498db;
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

    hr {
        border: 0;
        height: 1px;
        background: #ccc;
        margin: 20px 0;
    }

    dl {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        max-width: 600px;
        margin: 20px auto;
    }

        dl dt {
            font-weight: bold;
            color: #2c3e50;
            margin-top: 10px;
        }

        dl dd {
            margin: 0;
            padding: 5px 0;
        }

    .back-btn {
        display: inline-block;
        margin-top: 20px;
        background-color: #3498db;
        padding: 10px 20px;
        border-radius: 5px;
        color: white;
        text-decoration: none;
        transition: 0.3s;
    }

        .back-btn:hover {
            background-color: #2980b9;
        }

    .welcome-txt{
        font-weight: 500;
        font-style: italic;
    }
</style>

<div class="container text-center">
    <h1 class="display-4 welcome-txt"><b>Welcome to DBTK</b></h1>
    <br />
    <a href="Customers/Index" class="custom-btn">Customer Orders</a>
    <a href="Inventories/Index" class="custom-btn">Inventories</a>
    <br />
    <h4 class="welcome-txt">About DBTK</h4>
    <p>
        DBTK (Don't Blame The Kids) is a Filipino streetwear brand known for its bold designs, youthful energy,
        and strong community culture. Inspired by creativity and self-expression, DBTK offers high-quality apparel
        that blends style and meaning, making it a favorite among fashion-forward individuals.
    </p>
    <br />
    <a href="/Customers/SyncCustomerToInventory" class="custom-btn">Sync Customer to Inventory</a>

</div>
