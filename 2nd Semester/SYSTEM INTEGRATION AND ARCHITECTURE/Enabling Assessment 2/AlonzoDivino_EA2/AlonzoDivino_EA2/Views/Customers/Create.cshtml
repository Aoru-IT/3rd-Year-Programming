@model AlonzoDivino_EA2.Models.Customer

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Customer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="customerName" class="control-label">Customer Name</label>
                <input asp-for="customerName" class="form-control" />
                <span asp-validation-for="customerName" class="text-danger"></span>
            </div>
            <div class="form-group">        
                <label asp-for="Address" class="control-label">Address</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="itemName" class="control-label">Item Name</label>
                <select asp-for="itemName" class="form-control" asp-items="ViewBag.ItemName"></select>
                <span asp-validation-for="itemName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span> <!-- Error will appear here -->
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const itemNameSelect = document.querySelector("#itemName");
            const quantityInput = document.querySelector("#Quantity");

            itemNameSelect.addEventListener("change", async function () {
                const itemName = itemNameSelect.value;
                const response = await fetch(`/Customers/GetInventoryQuantity?itemName=${itemName}`);
                const data = await response.json();

                if (data.quantity !== undefined) {
                    quantityInput.setAttribute("max", data.quantity);
                }
            });

            quantityInput.addEventListener("input", function () {
                const maxQuantity = parseInt(quantityInput.getAttribute("max"));
                if (quantityInput.value > maxQuantity) {
                    quantityInput.setCustomValidity(`The available quantity is ${maxQuantity}. You cannot order more than that.`);
                } else {
                    quantityInput.setCustomValidity("");
                }
            });
        });
    </script>
}