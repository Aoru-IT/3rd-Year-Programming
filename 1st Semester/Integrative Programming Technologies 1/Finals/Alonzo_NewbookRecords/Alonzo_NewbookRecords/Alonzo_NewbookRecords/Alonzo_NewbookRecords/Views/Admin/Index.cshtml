@{
    @model Alonzo_NewbookRecords.Models.Admin

}

<div style="display: flex; align-items: flex-start; justify-content: center; height: calc(100vh - 100px); gap: 2rem; margin: 0; padding: 0; position: relative;">


    <div style="flex: 1; text-align: center; margin-left: -150px;  margin-top: 100px;">
        <img src="@(Url.Content("~/images/login_img.png"))" width="540" height="580" alt="Login Illustration" />
    </div>

    <div style="flex: 1; max-width: 400px; margin-top: 200px; margin-left: -150px;">
        <h2 style="font-size: 3rem; color: #2c3e50; margin-bottom: 1rem; text-align: center;">Welcome back</h2>
        <h3 style="font-size: 1.5rem; color: #1A508B; margin-bottom: 1.5rem; text-align: center;">Fill all fields to log-in.</h3>

        <form asp-action="Auth" method="post">
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem; color: #1A508B;">Username:</label>
                <input asp-for="inputUser" required
                       style="width: 100%; padding: 0.5rem; font-size: 1rem; border: 1px solid #ccc; border-radius: 4px;" />
            </div>
            <div style="margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem; color: #1A508B;">Password:</label>
                <input asp-for="inputPass" type="password" required
                       style="width: 100%; padding: 0.5rem; font-size: 1rem; border: 1px solid #ccc; border-radius: 4px;" />
            </div>
            <button type="submit"
                    style="width: 100%; padding: 0.7rem; font-size: 1.2rem; color: white; background-color: #2c3e50; border: none; border-radius: 4px; cursor: pointer;">
                Log-In
            </button>
        </form>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div style="color: red; margin-top: 1rem;">
                @Html.ValidationSummary(false)
            </div>
        }
    </div>
</div>


